{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "assumption_hunter": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "--locked", "--no-dev", "--extra", "mcp",
        "--project", "${PLUGIN_ROOT}",
        "python", "-B", "${PLUGIN_ROOT}/skills/assumption-hunter/scripts/mcp_server.py"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv"
      }
    }
  }
}
